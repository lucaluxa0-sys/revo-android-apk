+    /**
+     * Coarse world-view signature used only as movement evidence. The crop avoids
+     * Roblox's lower touch controls and most top HUD chrome so accepted joystick
+     * gestures must also produce visible scene response before we call them proven.
+     */
+    private static int[] visualSignature(Bitmap frame) {
+        if (frame == null || frame.isRecycled()) return null;
+        int w = frame.getWidth(), h = frame.getHeight();
+        if (w < 32 || h < 32) return null;
+        final int cols = 12, rows = 8;
+        int left = Math.max(0, Math.min(w - 1, Math.round(w * 0.20f)));
+        int right = Math.max(left + 1, Math.min(w - 1, Math.round(w * 0.86f)));
+        int top = Math.max(0, Math.min(h - 1, Math.round(h * 0.12f)));
+        int bottom = Math.max(top + 1, Math.min(h - 1, Math.round(h * 0.68f)));
+        int[] out = new int[cols * rows];
+        int k = 0;
+        try {
+            for (int y = 0; y < rows; y++) {
+                int py = top + Math.round((bottom - top) * (y + 0.5f) / rows);
+                py = Math.max(0, Math.min(h - 1, py));
+                for (int x = 0; x < cols; x++) {
+                    int px = left + Math.round((right - left) * (x + 0.5f) / cols);
+                    px = Math.max(0, Math.min(w - 1, px));
+                    int color = frame.getPixel(px, py);
+                    int r = (color >> 16) & 0xff, g = (color >> 8) & 0xff, b = color & 0xff;
+                    out[k++] = (77 * r + 150 * g + 29 * b) >> 8;
+                }
+            }
+            return out;
+        } catch (Throwable ignored) {
+            return null;
+        }
+    }
+
+    private void collectVisualMovementEvidence(Bitmap frame, long now, boolean robloxForeground) {
+        int[] before = visualBaseline;
+        if (before == null || now < visualProbeAfterMs) return;
+        visualBaseline = null;
+        int[] after = visualSignature(frame);
+        if (after == null || after.length != before.length || before.length == 0) return;
+        long absoluteDelta = 0;
+        int materiallyChanged = 0;
+        for (int i = 0; i < before.length; i++) {
+            int delta = Math.abs(after[i] - before[i]);
+            absoluteDelta += delta;
+            if (delta >= 14) materiallyChanged++;
+        }
+        double meanDelta = absoluteDelta / (255.0 * before.length);
+        double changedFraction = materiallyChanged / (double) before.length;
+        boolean confirmed = robloxForeground && (meanDelta >= 0.035 || changedFraction >= 0.20);
+        visualMovementSamples++;
+        if (confirmed) visualMovementConfirmedSamples++;
+        lastVisualMeanDelta = meanDelta;
+        lastVisualChangedFraction = changedFraction;
+        lastVisualMovementConfirmed = confirmed;
+        Log.i("RevoMovementEvidence", String.format(Locale.US,
+                "sample=%d confirmed=%s meanDelta=%.4f changedFraction=%.3f robloxForeground=%s display=%d",
+                visualMovementSamples, confirmed, meanDelta, changedFraction, robloxForeground, displayId));
+    }
